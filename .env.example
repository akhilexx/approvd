# Approvd configuration. Copy to .env and fill in. Never commit .env.
# Everything defaults to fully offline mock mode, so the app runs with no keys at all.

# ---- PayPal ----
# mock    = in-memory PayPal simulator (no network, no keys)
# sandbox = real PayPal REST sandbox (https://api-m.sandbox.paypal.com)
PAYPAL_MODE=mock
# From developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional override (sandbox is the default; this project never targets live)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Where buyers are sent after approving / cancelling a checkout
PUBLIC_BASE_URL=http://localhost:8787
# Sandbox test accounts, used only by `npm run e2e:sandbox` (payout receiver; redaction of account emails)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUSINESS_EMAIL=

# ---- LLM ----
# mock   = deterministic built-in planner (no keys; understands the demo phrasings)
# azure  = Azure OpenAI Service (what the hosted demo uses)
# openai = any OpenAI-compatible chat-completions API (OpenAI, xAI, Groq, OpenRouter, Together, Gemini's OpenAI endpoint, local Ollama...)
LLM_MODE=mock
# Azure OpenAI: https://<resource>.openai.azure.com, key from Azure portal > Keys and Endpoint, your deployment name
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# chat-completions api-version (used by the chat wire)
AZURE_OPENAI_API_VERSION=2024-10-21
# auto = chat completions, switching to the Responses API if the deployment refuses tools there (reasoning models);
# chat / responses = force one. Set responses for reasoning deployments to skip the first failed probe.
AZURE_OPENAI_WIRE=auto
# Optional for reasoning deployments: low | medium | high (Responses wire only)
AZURE_OPENAI_REASONING_EFFORT=
# OpenAI-compatible provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Per-call limits for any provider
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200

# ---- Spend policy (guardrails the agent cannot override) ----
# Any money-moving action above this amount needs a human approval click
POLICY_APPROVAL_THRESHOLD=50
# Hard ceiling per single action (denied outright above this)
POLICY_MAX_PER_ACTION=500
# Rolling 24h cap across all outgoing money (refunds + payouts)
POLICY_DAILY_OUTFLOW_CAP=1000
# Comma-separated payout allowlist: exact emails or @domain suffixes. Empty = everyone needs approval.
POLICY_PAYEE_ALLOWLIST=@example.com
# Comma-separated tools the agent may never call
POLICY_BLOCKED_TOOLS=

# ---- Server ----
PORT=8787
# Optional shared demo passcode for the hosted demo (blank = open)
DEMO_PASSCODE=
# ---- Hosted-demo protections (defaults shown) ----
# POST requests per minute per client IP
RATE_LIMIT_PER_MIN=30
# Header the trusted edge sets with the client IP (Render: true-client-ip). Blank = socket address. X-Forwarded-For is never trusted.
CLIENT_IP_HEADER=
# POSTs per UTC day across all clients
DAILY_REQUEST_CAP=2000
# Max characters per chat message / max JSON body bytes
MAX_INPUT_CHARS=600
MAX_BODY_BYTES=16000
# Chat turns per browser session; sessions kept in memory
SESSION_TURN_CAP=40
MAX_SESSIONS=500
# LLM spend caps per UTC day; when hit, the offline planner answers instead
LLM_DAILY_CALL_CAP=400
LLM_DAILY_TOKEN_CAP=600000
# Circuit breaker: consecutive LLM failures before pausing the LLM, and for how long
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_MS=300000
# Exact origin allowed to call the API cross-site (blank = same-origin only)
CORS_ORIGIN=
# Set LOG_REQUESTS=0 to silence the per-request log line (it never contains message text)
LOG_REQUESTS=1
